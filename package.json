{
  "name": "bunpro-mcp-server",
  "version": "0.1.0",
  "description": "Unofficial read-only Bunpro MCP with local and OAuth-protected hosted transports",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Yash Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yash-278/bunpro-mcp.git"
  },
  "homepage": "https://github.com/yash-278/bunpro-mcp#readme",
  "bugs": {
    "url": "https://github.com/yash-278/bunpro-mcp/issues"
  },
  "keywords": [
    "bunpro",
    "mcp",
    "model-context-protocol",
    "japanese",
    "language-learning"
  ],
  "main": "dist/index.js",
  "bin": {
    "bunpro-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "live:test:auth": "npm run build && node --import tsx scripts/live-mcp-auth-smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
