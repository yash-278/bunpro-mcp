# Local stdio mode
BUNPRO_USERNAME=
BUNPRO_PASSWORD=

# Public Railway HTTP mode
TRANSPORT=http
PUBLIC_BASE_URL=https://your-bunpro-mcp.example.com
AUTHORIZATION_SERVER_URL=https://your-tenant.auth0.com/
AUTH_AUDIENCE=https://your-bunpro-mcp.example.com/mcp
AUTH_SCOPE=bunpro.read
DATABASE_URL=
# Generate each secret independently with: openssl rand -base64 32
BUNPRO_CREDENTIALS_ENCRYPTION_KEY=
SETUP_TOKEN_SECRET=
